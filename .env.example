# Required: Keboola Storage API token used server-side to call ai.keboola.com.
# This is the ONLY credential — MCP clients hit /mcp with no auth.
# On a Keboola data app, configure this as a `#`-prefixed (encrypted) secret.
KBC_STORAGE_TOKEN=

# Optional: override the AI service base URL. Defaults to https://ai.keboola.com.
# KBC_AI_SERVICE_URL=https://ai.keboola.com

# Optional: HTTP port the FastMCP app binds. Defaults to 5000.
# PORT=5000
